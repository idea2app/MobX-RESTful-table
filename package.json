{
  "name": "mobx-restful-table",
  "version": "3.0.0-rc.1",
  "license": "LGPL-3.0",
  "author": "shiy2008@gmail.com",
  "description": "A Pagination Table & Scroll List component suite for CRUD operation, which is based on MobX RESTful & React.",
  "keywords": [
    "table",
    "form",
    "component",
    "crud",
    "mobx",
    "restful",
    "react"
  ],
  "homepage": "https://idea2app.github.io/MobX-RESTful-table/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idea2app/MobX-RESTful-table.git"
  },
  "bugs": {
    "url": "https://github.com/idea2app/MobX-RESTful-table/issues"
  },
  "source": "source/index.ts",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "main": "dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/esm/index.js",
    "require": "./dist/index.js"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.24",
    "classnames": "^2.5.1",
    "idea-react": "^3.0.0-rc.2",
    "lodash": "^4.18.1",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "react-bootstrap-editor": "^3.0.0-rc.0",
    "regenerator-runtime": "^0.14.1",
    "web-utility": "^4.8.1"
  },
  "peerDependencies": {
    "mobx": ">=6.11",
    "mobx-i18n": ">=0.6",
    "mobx-react": ">=9",
    "react": ">=16.8"
  },
  "devDependencies": {
    "@mlightcad/cad-simple-viewer": "^1.7.8",
    "@mlightcad/data-model": "^1.15.25",
    "@octokit/openapi-types": "^29.0.1",
    "@open-file-viewer/core": "^1.0.0",
    "@open-file-viewer/react": "^1.0.0",
    "@parcel/config-default": "~2.16.4",
    "@parcel/packager-ts": "~2.16.4",
    "@parcel/transformer-less": "~2.16.4",
    "@parcel/transformer-typescript-tsc": "~2.16.4",
    "@parcel/transformer-typescript-types": "~2.16.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "global-jsdom": "^31.0.0",
    "https-browserify": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "koajax": "^3.3.1",
    "lint-staged": "^17.6.0",
    "marked": "^18.2.0",
    "mobx": "^7.1.6",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-react": "^10.0.3",
    "os-browserify": "^0.3.0",
    "parcel": "~2.16.4",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.0",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-element-to-jsx-string": "^18.0.0",
    "rimraf": "^6.1.4",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "~6.0.3",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "tabWidth": 2,
    "printWidth": 100
  },
  "lint-staged": {
    "*.{md,json,yml,ts}": "prettier --write"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
  "targets": {
    "main": {
      "optimize": true
    },
    "module": {
      "optimize": true
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "scripts": {
    "prepare": "husky",
    "preview": "cd preview/  &&  rimraf ../.parcel-cache dist/  &&  parcel",
    "test": "lint-staged  &&  cd test/  &&  tsc --noEmit --project tsconfig.json  &&  node --import ./register.mts --test --test-timeout=10000 \"**/*.test.tsx\"",
    "pack-preview": "cd preview/  &&  rimraf ../.parcel-cache dist/  &&  tsc --noEmit --project tsconfig.json  &&  parcel build --public-url=. --dist-dir=../docs/preview/",
    "pack-dist": "rimraf dist/ docs/  &&  parcel build  &&  sed -i 's/require(\"\\.\\/index\\.css\");//' dist/index.js  &&  rimraf dist/index.js.map",
    "fix-esm": "cd dist/esm/  &&  rm index.css*  &&  sed -i 's/import\"\\.\\/index\\.css\";//' index.js  &&  rimraf index.js.map",
    "build": "npm run pack-dist  &&  npm run fix-esm  &&  typedoc source/  &&  npm run pack-preview",
    "prepublishOnly": "npm test  &&  npm run build"
  }
}
