                var suff = src.split(".").pop().toLowerCase();
                if (sufs.indexOf(suff) == -1) continue;
                var xhr = new XMLHttpRequest();
                UTIF._xhrs.push(xhr);
                UTIF._imgs.push(img);
                xhr.open("GET", src);
                xhr.responseType = "arraybuffer";
                xhr.onload = UTIF._imgLoaded;
                xhr.send();
            }
