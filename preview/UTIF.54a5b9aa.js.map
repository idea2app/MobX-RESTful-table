                if (debug) log("   ".repeat(depth), tag, type, UTIF.tags[tag], arr);
                if (tag == 330 && ifd["t272"] && ifd["t272"][0] == "DSLR-A100") ;
                else if (tag == 330 || tag == 34665 || tag == 50740 && bin.readUshort(data, bin.readUint(arr, 0)) < 300) {
