            var vsns = ifds, ma = 0, page = vsns[0];
            if (ifds[0].subIFD) vsns = vsns.concat(ifds[0].subIFD);
            for(var i = 0; i < vsns.length; i++){
                var img = vsns[i];
                if (img["t258"] == null || img["t258"].length < 3) continue;
